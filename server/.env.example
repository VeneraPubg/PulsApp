// Скопируйте в .env для локального запуска. На Render эти же значения
// задаются как переменные окружения (Blueprint сам их спросит).

// Строка подключения MongoDB Atlas (Atlas → Connect → Drivers → mongodb+srv://...)
MONGODB_URI=mongodb+srv://<логин>:<пароль>@<кластер>/pulseapp?retryWrites=true&w=majority

// Секрет для JWT (случайная длинная строка)
JWT_SECRET=change-me-to-long-random-string
